# Contas GHL: [{"casa","nome","base":"vendas|planejamento|decoracao","locationId","token"}]
GHL_CASAS_JSON=
# Upstash Redis (dados do painel ficam sob o prefixo magical:)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Segredo do cron (a Vercel envia como Authorization: Bearer)
CRON_SECRET=
# Mínimo 32 caracteres: openssl rand -hex 32
SESSION_SECRET=
# [{"email","nome","senha":"<saída de npm run hash-senha -- 'senha'>"}]
PAINEL_USUARIOS=
